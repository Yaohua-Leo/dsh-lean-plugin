{
  "name": "@local/dsh-lean-preset",
  "version": "1.1.0",
  "type": "module",
  "main": "index.js",
  "description": "Declares the Lean Proof Assistant agent preset (lean-lsp MCP, formalization contract persona, upstream skills) and the lean_selfcheck tool.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "capabilities.js",
    "runtime-policy.json",
    "cordis.patch.yml",
    "skills/**",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
